Ex_BoreRapidRetract_Start : 
                        : $N WorkPlaneCode FeedUnit
                        : $N HoleCycleCode* ReturnPlaneCode* $ZorWForce RPlane* DwellTime* FeedRateCode

Ex_BoreRapidRetract_Body : 
                        : $N XAbsolute YAbsolute $ZorW WC1RotaryAxis1 RotaryAxis2 RPlane DwellTime* FeedRateCode

######### Back Boring Cycle ###################################################

Ex_BackBoring_Start     : $N WorkPlaneCode FeedUnit
                        : $N HoleCycleCode* ReturnPlaneCode* $ZorWForce RPlane* Offset* DwellTime* FeedRateCode

Ex_BackBoring_Body      : $N XAbsolute YAbsolute $ZorW WC1RotaryAxis1 RotaryAxis2 RPlane DwellTime* Offset FeedRateCode

######### Boring Cycle with Manual Extraction  ################################

Ex_BoringManualExtraction_Start : 
                        : $N WorkPlaneCode FeedUnit
                        : $N HoleCycleCode* ReturnPlaneCode* $ZorWForce RPlane* DwellTime* FeedRateCode

Ex_BoringManualExtraction_Body : 
