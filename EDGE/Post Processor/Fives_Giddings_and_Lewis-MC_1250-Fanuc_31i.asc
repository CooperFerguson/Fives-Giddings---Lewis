######### Probing #############################################################

Define ProbingPrintOutputData ## This argument can only be set to 1 or 2, so anything else is illegal
  If (NextClfile(2225)=1 || NextClfile(2225)=2) PrintOutput* EndIf
EndDefine

Define RadialClearanceIfNeeded ## No need to output if default
  If ((MeasurementCode=Metric && NextClfile(2210)<>5.0) || (MeasurementCode=Inch && NextClfile(2210)<>0.2)) RadialClearance* EndIf
EndDefine

Define UpdateWorkOffset
  If (NextCLFile(2230)) MiscFormat11*(NextCLFile(2230)+100) ElseIf (NextCLFile(2221)) MiscFormat11*(NextCLFile(2221)+1-54) EndIf
EndDefine

Ex_Probe_Rapid          : $N ProbeRapid* XAbsolute YAbsolute TC1LinearAxis2 WC1LinearAxis1 FeedRate

Ex_Probe_Linear         : $N ProbeLinear* XAbsolute YAbsolute TC1LinearAxis2 WC1LinearAxis1 FeedRate

Ex_Probe_Spin_On        : $N ProbeSpinOn* ## PrintOutput*(1) ## P9832/P9833 ## ACF 2026/11/23 Case 02650943

Ex_Probe_SinglePoint    : $N ProbeSinglePoint* XAbsolute YAbsolute TC1LinearAxis2 WC1LinearAxis1 \\
                          ProbingExperienceValue PercentFeedback FeatureTolerance PositionTolerance \\
                          OverTravelDistance RadialClearance $UpdateWorkOffset UpdateToolOffsetNumber UpperToleranceLimit \\
                          NullBand $ProbingPrintOutputData
                        : $N InLineNCString

Ex_Probe_BoreBoss       : $N ProbeBoreBoss* NominalDiameter* TC1LinearAxis2 WC1LinearAxis1 \\
                          ProbingExperienceValue PercentFeedBack FeatureTolerance PositionTolerance \\
                          OverTravelDistance RadialClearance $UpdateWorkOffset UpdateToolOffsetNumber \\
                          UpperToleranceLimit NullBand $ProbingPrintOutputData
                        : $N InLineNCString

Ex_Probe_WebPocket      : $N ProbeWebPocket* XTranslation YTranslation TC1LinearAxis2 WC1LinearAxis1 \\
                          ProbingExperienceValue PercentFeedBack FeatureTolerance PositionTolerance \\
                          OverTravelDistance RadialClearance $UpdateWorkOffset UpdateToolOffsetNumber \\
                          UpperToleranceLimit NullBand $ProbingPrintOutputData
                        : $N InLineNCString

Ex_Probe_InternalCorner : $N ProbeInternalCorner* XAbsolute* YAbsolute* ProbeAngleTolerance* \\
                          ProbeXIncremental* ProbeYIncremental* PositionTolerance OverTravelDistance $UpdateWorkOffset \\
                          UpperToleranceLimit $ProbingPrintOutputData
                        : $N InLineNCString

Ex_Probe_ExternalCorner : $N ProbeExternalCorner* XAbsolute* YAbsolute* ProbeAngleTolerance* \\
                          ProbeXIncremental* ProbeYIncremental* PositionTolerance OverTravelDistance $UpdateWorkOffset \\
                          UpperToleranceLimit $ProbingPrintOutputData
                        : $N InLineNCString

Ex_Probe_5PtRectangle   : GpAbort(ErrorMessage(14) + "  Operation Number " + PartOperationNumber)
                        : SetFormatableSymbol(ProbeNominalXValue, "D") SetFormatableSymbol(ProbeNominalYValue, "E")
                        : $N Probe5PtRectangle* ProbeNominalXValue ProbeNominalYValue ProbeNominalZValue \\
                          ProbeRectangleDoubleTouchSide* ProbeAngleTolerance ProbeRectangleRelativeX PositionTolerance OverTravelDistance \\
                          RadialClearance $UpdateWorkOffset ProbeRectangleDoubleTouchDistance UpperToleranceLimit \\
                          ProbeRectangleRelativeY $ProbingPrintOutputData
                        : SetFormatableSymbol(ProbeNominalXValue, "X") SetFormatableSymbol(ProbeNominalYValue, "Y")
                        : $N InLineNCString

Ex_Probe_4thAxis        : $N Probe4thAxis* ProbeNominalXValue ProbeNominalYValue ProbeNominalZValue \\
                          OverTravelDistance ProbeAngleTolerance $UpdateWorkOffset If (SpindleCode=SpindleAux) "V2" EndIf $ProbingPrintOutputData
                        : $N InLineNCString

Ex_Probe_AngledSinglePoint :
                        : $N ProbeAngledSinglePoint* ProbeSurfaceAngle ProbeNominalSurfaceDistance* \\
                          ProbingExperienceValue PercentFeedback FeatureTolerance PositionTolerance \\
                          OverTravelDistance $UpdateWorkOffset UpdateToolOffsetNumber UpperToleranceLimit \\
                          NullBand $ProbingPrintOutputData
                        : $N InLineNCString

Ex_Probe_AngledWebPocket :
                        : $N ProbeAngledWebPocket* ProbeSurfaceAngle* ProbeNominalSize* XAbsolute YAbsolute TC1LinearAxis2 WC1LinearAxis1 \\
                          ProbingExperienceValue PercentFeedback FeatureTolerance PositionTolerance \\
                          OverTravelDistance RadialClearance $UpdateWorkOffset UpdateToolOffsetNumber \\
                          UpperToleranceLimit NullBand $ProbingPrintOutputData
                        : $N InLineNCString

Ex_Probe_3PtBoreBoss    : $N Probe3PtBoreBoss* ProbeFirstAngle* ProbeSecondAngle* ProbeThirdAngle* \\
                          NominalDiameter* TC1LinearAxis2 WC1LinearAxis1 ProbingExperienceValue PercentFeedBack FeatureTolerance PositionTolerance \\
                          OverTravelDistance RadialClearance $UpdateWorkOffset UpdateToolOffsetNumber \\
                          UpperToleranceLimit NullBand $ProbingPrintOutputData
                        : $N InLineNCString

Ex_Probe_Spin_Off       : $N ProbeSpinOff* ## PrintOutput*(1) ## ACF 2026/11/23 Case 02650943

############################# End of Examples ###############################################################
