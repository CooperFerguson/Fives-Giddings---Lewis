############################# General #########################################

## All possible error messages are Defined here
Define ErrorMessages
  ErrorMessage(1)=("ERROR: Incorrect Feed Unit selection.  5Axis Operations with Dynamic Compensation must use Inverse Feed Time.") \\
  ErrorMessage(2)=("ERROR: Incorrect Feed Unit selection.  5Axis operations with RTCP must use Per Minute or Inverse Feed Time.") \\
  ErrorMessage(3)=("ERROR: Incorrect Feed Unit selection.  Tapping Cycles must use Per Revolution.") \\
  ErrorMessage(4)=("ERROR: Incorrect Work Offset Setup.  Custom Offset Type is not supported.  Please select either Standard or Extended.") \\
  ErrorMessage(5)=("ERROR: Incorrect Work Offset Transformation.  Tilted Plane/G68.2 may not be supported on a machine with less than 5 axes.") \\
  ErrorMessage(6)=("ERROR: Incorrect NC Output Setting.  The post processor doesn't support Tool Compensation in 5Axis Simultaneous operations.") \\
  ErrorMessage(7)=("ERROR: RTCP vector format (G43.5) is only supported when RTCP Coordinate Mode = Rotate With Part.") \\
  ErrorMessage(8)=("ERROR: R Parameter must be between 1 and 10 (Operation Custom Setting 1)") \\
  ErrorMessage(9)=("ERROR: P Parameter must be 1 or 2 (Operation Custom Setting 1)") \\ ## Mitsubishi High Speed Machining Custom Setting
  ErrorMessage(10)=("ERROR: Both Fanuc (CL10060) and Mits (CL10061) Control Series detected in Machine Setup file (.mprj) custom settings") \\
  ErrorMessage(11)=("ERROR: Both Fanuc (CL10080) and Mits (CL10081) High Speed Machining Modes detected in Machine Setup file (.mprj) custom settings")\\
  ErrorMessage(12)=("ERROR: Cannot detect Control Series custom setting in the Machine Setup file (.mprj)") \\
  ErrorMessage(13)=("ERROR: Missing Fanuc High Speed Machining Mode (CL10080) custom setting in the Machine Setup file (.mprj)") \\
  ErrorMessage(14)=("ERROR: Missing Mits High Speed Machining Mode (CL10081) custom setting in the Machine Setup file (.mprj)") \\
  ErrorMessage(15)=("ERROR: Collinear Solution must be set to Z Position. W Position, and Z & W Free are not yet supported.")
EndDefine

Define N
  If (SequenceNumberOutput=2) SequenceNumber EndIf
EndDefine

Define NAtOperation
  If (SequenceNumberOutput=1) SequenceNumber EndIf
EndDefine

Define OutputToolChangeSequenceNumber
  If (SequenceNumberOutput=3) \\
    SequenceNumber*(PresentTool) \\
  Else \\
    SequenceNumber* \\
  EndIf
EndDefine

Define RSpOn
  OutputFormatCode(2)
EndDefine

Define RSpOff
  OutputFormatCode(0)
EndDefine

############################# Machine Custom Setting Functions ################

Define SetStandardCustomSettingVariables
  : If (ExistCLFile(10000)) OutputToolList=           (NextCLFile(10000)) If (OutputToolList=2) ToolDefinitionOrder(ByUsage) EndIf EndIf
  : If (ExistCLFile(10001)) OutputWorkOffsetList=     (NextCLFile(10001)) EndIf
  : If (ExistCLFile(10002)) OutputOperationList=      (NextClFile(10002)) EndIf
  : If (ExistCLFile(10010)) LinearAxesPrecision=      (NextCLFile(10010)) Else If (MeasurementCode=Inch) LinearAxesPrecision=(5) Else LinearAxesPrecision=(4) EndIf EndIf
  : If (ExistCLFile(10011)) RotaryAxesPrecision=      (NextCLFile(10011)) Else If (MeasurementCode=Inch) RotaryAxesPrecision=(3) Else RotaryAxesPrecision=(3) EndIf EndIf
  : If (ExistCLFile(10012)) SequenceNumberIncrement=  (NextCLFile(10012)) Else SequenceNumberIncrement=(NCodeIncrement) EndIf
  : If (ExistCLFile(10013)) SequenceNumberOutput=     (NextCLFile(10013)) Else SequenceNumberOutput=(0) EndIf
  : If (ExistCLFile(10014)) CircularInterpolation=    (NextCLFile(10014)) If (CircularInterpolation=2) CircleMode(By180) EndIf EndIf
  : If (ExistCLFile(10015)) HelixOutput=              (NextCLFile(10015)) Else HelixOutput=(1) EndIf
  : If (ExistCLFile(10016) && NextCLFile(10016))      RemoveSpaces(1)     EndIf
  : If (ExistCLFile(10020)) AngleRotationMode=        (NextCLFile(10020)) EndIf
  : If (ExistCLFile(10021)) RTCPMode=                 (NextCLFile(10021)) EndIf
  : If (ExistCLFile(10031)) PreStageNextTool=         (NextCLFile(10031)) EndIf
  : If (ExistCLFile(10032)) ToolCancelStopCode=       (NextCLFile(10032)) EndIf
  : If (ExistCLFile(10040)) CoolantOutputLocation=    (NextCLFile(10040)) EndIf
  : If (ExistCLFile(10050)) EndOfProgramMode=         (NextCLFile(10050)) EndIf

  : If (FanucControl)
  :   If (ExistCLFile(10080)) HighSpeedMachineType=   (NextCLFile(10080)) EndIf
  : ElseIf (MitsControl)
  :   If (ExistCLFile(10081)) HighSpeedMachineType=   (NextCLFile(10081)) EndIf
  : EndIf
EndDefine

Define SetMachineSpecificCustomSettings
  : ## List machine specific custom settings to variables here
EndDefine

Define SetSafeRestartMode
  : SafeRestart=(NextCLFile(14004))
EndDefine

Define SetDynamicOffsetType
  : If (NextClFile(14008)<=2)
  :   SetFormatableSymbol(DynamicOffsetNumber, "G54.2~P")
  : ElseIf (NextClFile(14008)=3)
  :   SetFormatableSymbol(DynamicOffsetNumber, "G54.4~P") ## Work around until WSEC is decoupled from dynamic offset UI
  : EndIf
EndDefine

Define SetNCodeIncrement
 : NCodeIncrement(SequenceNumberIncrement)
EndDefine

Define SetMachineTolerances
  : SetFormatableMaximum(InverseTimeFeed, 99999)
  : SetFormatableMaximum(Feedrate, 99999)
  : If (LinearAxesPrecision)
  :   MachineTolerance(1/Exp(LinearAxesPrecision*Ln(10)))
  :   StepTolerance(1/Exp(LinearAxesPrecision*Ln(10)))
  : EndIf
  : If (MeasurementCode=Inch)
  :   MaxCircleRadius(394.)
  : Else
  :   MaxCircleRadius(9999.)
  : EndIf
EndDefine

Define SetLinearAxesPrecision
  : If (LinearAxesPrecision>0)
  :   If (MeasurementCode=Inch)
  :     SetFormatableInch(XAbsolute,4,LinearAxesPrecision)
  :     SetFormatableInch(YAbsolute,4,LinearAxesPrecision)
  :     SetFormatableInch(ZAbsolute,4,LinearAxesPrecision)
  :     SetFormatableInch(TC1LinearAxis2,4,LinearAxesPrecision)
  :     SetFormatableInch(WC1LinearAxis1,4,LinearAxesPrecision)
  :     SetFormatableInch(XCenterAbsolute,4,LinearAxesPrecision)
  :     SetFormatableInch(YCenterAbsolute,4,LinearAxesPrecision)
  :     SetFormatableInch(ZCenterAbsolute,4,LinearAxesPrecision)
  :     SetFormatableInch(CircleRadius,4,LinearAxesPrecision)
  :     SetFormatableInch(MiscFormat1,4,LinearAxesPrecision)
  :     SetFormatableInch(MiscFormat2,4,LinearAxesPrecision)
  :     SetFormatableInch(MiscFormat3,4,LinearAxesPrecision)
  :     SetFormatableInch(XSDIM,4,LinearAxesPrecision)
  :     SetFormatableInch(YSDIM,4,LinearAxesPrecision)
  :     SetFormatableInch(ZSDIM,4,LinearAxesPrecision)
  :     SetFormatableInch(ChipFeedRate,4,LinearAxesPrecision)
  :     SetFormatableInch(Peck,4,LinearAxesPrecision)
  :     SetFormatableInch(Offset,4,LinearAxesPrecision)
  :     SetFormatableInch(RPlane,4,LinearAxesPrecision)
  :     SetFormatableInch(XCoorOffset,4,LinearAxesPrecision)
  :     SetFormatableInch(YCoorOffset,4,LinearAxesPrecision)
  :     SetFormatableInch(ZCoorOffset,4,LinearAxesPrecision)
  :     SetFormatableInch(XDynamicOffset,4,LinearAxesPrecision)
  :     SetFormatableInch(YDynamicOffset,4,LinearAxesPrecision)
  :     SetFormatableInch(ZDynamicOffset,4,LinearAxesPrecision)
  :     SetFormatableInch(XTranslation,4,LinearAxesPrecision)
  :     SetFormatableInch(YTranslation,4,LinearAxesPrecision)
  :     SetFormatableInch(ZTranslation,4,LinearAxesPrecision)
  :   Else
  :     SetFormatableMetric(XAbsolute,5,LinearAxesPrecision)
  :     SetFormatableMetric(YAbsolute,5,LinearAxesPrecision)
  :     SetFormatableMetric(ZAbsolute,5,LinearAxesPrecision)
  :     SetFormatableMetric(TC1LinearAxis2,5,LinearAxesPrecision)
  :     SetFormatableMetric(WC1LinearAxis1,5,LinearAxesPrecision)
  :     SetFormatableMetric(XCenterAbsolute,5,LinearAxesPrecision)
  :     SetFormatableMetric(YCenterAbsolute,5,LinearAxesPrecision)
  :     SetFormatableMetric(ZCenterAbsolute,5,LinearAxesPrecision)
  :     SetFormatableMetric(CircleRadius,5,LinearAxesPrecision)
  :     SetFormatableMetric(MiscFormat1,5,LinearAxesPrecision)
  :     SetFormatableMetric(MiscFormat2,5,LinearAxesPrecision)
  :     SetFormatableMetric(MiscFormat3,5,LinearAxesPrecision)
  :     SetFormatableMetric(XSDIM,4,LinearAxesPrecision)
  :     SetFormatableMetric(YSDIM,4,LinearAxesPrecision)
  :     SetFormatableMetric(ZSDIM,4,LinearAxesPrecision)
  :     SetFormatableMetric(ChipFeedRate,4,LinearAxesPrecision)
  :     SetFormatableMetric(Peck,5,LinearAxesPrecision)
  :     SetFormatableMetric(Offset,5,LinearAxesPrecision)
  :     SetFormatableMetric(RPlane,5,LinearAxesPrecision)
  :     SetFormatableMetric(XCoorOffset,5,LinearAxesPrecision)
  :     SetFormatableMetric(YCoorOffset,5,LinearAxesPrecision)
  :     SetFormatableMetric(ZCoorOffset,5,LinearAxesPrecision)
  :     SetFormatableMetric(XDynamicOffset,5,LinearAxesPrecision)
  :     SetFormatableMetric(YDynamicOffset,5,LinearAxesPrecision)
  :     SetFormatableMetric(ZDynamicOffset,5,LinearAxesPrecision)
  :     SetFormatableMetric(XTranslation,5,LinearAxesPrecision)
  :     SetFormatableMetric(YTranslation,5,LinearAxesPrecision)
  :     SetFormatableMetric(ZTranslation,5,LinearAxesPrecision)
  :   EndIf
  : EndIf
EndDefine

Define SetProbingLinearAxesPrecision
  : If (LinearAxesPrecision>0)
  :   If (MeasurementCode=Inch)
  :     SetFormatableInch(OverTravelDistance,4,LinearAxesPrecision)
  :     SetFormatableInch(FeatureTolerance,4,LinearAxesPrecision)
  :     SetFormatableInch(PositionTolerance,4,LinearAxesPrecision)
  :     SetFormatableInch(NullBand,4,LinearAxesPrecision)
  :     SetFormatableInch(PercentFeedback,4,LinearAxesPrecision)
  :     SetFormatableInch(NominalDiameter,4,LinearAxesPrecision)
  :     SetFormatableInch(RadialClearance,4,LinearAxesPrecision)
  :     SetFormatableInch(ProbeXIncremental,4,LinearAxesPrecision)
  :     SetFormatableInch(ProbeYIncremental,4,LinearAxesPrecision)
  :   Else
  :     SetFormatableMetric(OverTravelDistance,5,LinearAxesPrecision)
  :     SetFormatableMetric(FeatureTolerance,5,LinearAxesPrecision)
  :     SetFormatableMetric(PositionTolerance,5,LinearAxesPrecision)
  :     SetFormatableMetric(NullBand,5,LinearAxesPrecision)
  :     SetFormatableMetric(PercentFeedback,5,LinearAxesPrecision)
  :     SetFormatableMetric(NominalDiameter,5,LinearAxesPrecision)
  :     SetFormatableMetric(RadialClearance,5,LinearAxesPrecision)
  :     SetFormatableMetric(ProbeXIncremental,5,LinearAxesPrecision)
  :     SetFormatableMetric(ProbeYIncremental,5,LinearAxesPrecision)
  :   EndIf
  : EndIf
EndDefine

Define SetRotaryAxesPrecision
  : If (RotaryAxesPrecision>0)
  :   If (MeasurementCode=Inch)
  :     SetFormatableInch(RotaryAxis1,4,RotaryAxesPrecision)
  :     SetFormatableInch(RotaryAxis2,4,RotaryAxesPrecision)
  :     SetFormatableInch(MiscFormat4,4,RotaryAxesPrecision)
  :     SetFormatableInch(MiscFormat5,4,RotaryAxesPrecision)
  :     SetFormatableInch(RotaryAxis1CoorOffset,4,RotaryAxesPrecision)
  :     SetFormatableInch(RotaryAxis2CoorOffset,4,RotaryAxesPrecision)
  :     SetFormatableInch(RollAngle,4,RotaryAxesPrecision)
  :     SetFormatableInch(PitchAngle,4,RotaryAxesPrecision)
  :     SetFormatableInch(YawAngle,4,RotaryAxesPrecision)
  :     SetFormatableInch(EulerGammaAngle,4,RotaryAxesPrecision)
  :     SetFormatableInch(EulerBetaAngle,4,RotaryAxesPrecision)
  :     SetFormatableInch(EulerAlphaAngle,4,RotaryAxesPrecision)
  :   Else
  :     SetFormatableMetric(RotaryAxis1,4,RotaryAxesPrecision)
  :     SetFormatableMetric(RotaryAxis2,4,RotaryAxesPrecision)
  :     SetFormatableMetric(MiscFormat4,4,RotaryAxesPrecision)
  :     SetFormatableMetric(MiscFormat5,4,RotaryAxesPrecision)
  :     SetFormatableMetric(RotaryAxis1CoorOffset,4,RotaryAxesPrecision)
  :     SetFormatableMetric(RotaryAxis2CoorOffset,4,RotaryAxesPrecision)
  :     SetFormatableMetric(RollAngle,4,RotaryAxesPrecision)
  :     SetFormatableMetric(PitchAngle,4,RotaryAxesPrecision)
  :     SetFormatableMetric(YawAngle,4,RotaryAxesPrecision)
  :     SetFormatableMetric(EulerGammaAngle,4,RotaryAxesPrecision)
  :     SetFormatableMetric(EulerBetaAngle,4,RotaryAxesPrecision)
  :     SetFormatableMetric(EulerAlphaAngle,4,RotaryAxesPrecision)
  :   EndIf
  : EndIf
EndDefine

Define SetProbingRotaryAxesPrecision
  : If (RotaryAxesPrecision>0)
  :   If (MeasurementCode=Inch)
  :     SetFormatableInch(ProbeAngleTolerance,4,RotaryAxesPrecision)
  :     SetFormatableInch(ProbeFirstAngle,4,RotaryAxesPrecision)
  :     SetFormatableInch(ProbeSecondAngle,4,RotaryAxesPrecision)
  :     SetFormatableInch(ProbeThirdAngle,4,RotaryAxesPrecision)
  :   Else
  :     SetFormatableMetric(ProbeAngleTolerance,4,RotaryAxesPrecision)
  :     SetFormatableMetric(ProbeFirstAngle,4,RotaryAxesPrecision)
  :     SetFormatableMetric(ProbeSecondAngle,4,RotaryAxesPrecision)
  :     SetFormatableMetric(ProbeThirdAngle,4,RotaryAxesPrecision)
  :   EndIf
  : EndIf
EndDefine

Define SetRotaryConfiguration
  : If (ExistCLFileAxis(RotaryAxisName(1)))
  :   If (CLFileAxis(7067, RotaryAxisName(1))<>3 || \\
        (CLFileAxis(7067, RotaryAxisName(1))=3 && (CLFileAxis(7072,RotaryAxisName(1))<>0 || \\
        CLFileAxis(7073,RotaryAxisName(1))<>0 || ABS(CLFileAxis(7074,RotaryAxisName(1)))<>1)))
  :     PrimaryRotaryAxis=(1)
  :     SetFormatableSymbol(RotaryAxis1, RotaryAxisName(1))
  :     SetFormatableSymbol(MiscFormat4, RotaryAxisName(1))
  :     SetFormatableSymbol(RotaryAxis1CoorOffset, RotaryAxisName(1))
  :   Else
  :     SetFormatableSign(RotaryAxis1,-1)
  :     SetFormatableSign(MiscFormat4,-1)
  :     SetFormatableSign(RotaryAxis1CoorOffset,-1)
  :   EndIf
  : EndIf
  : If (ExistCLFileAxis(RotaryAxisName(2)))
  :   If (CLFileAxis(7067, RotaryAxisName(2))<>3 || \\
        (CLFileAxis(7067, RotaryAxisName(2))=3 && (CLFileAxis(7072,RotaryAxisName(2))<>0 || \\
        CLFileAxis(7073,RotaryAxisName(2))<>0 || ABS(CLFileAxis(7074,RotaryAxisName(2)))<>1)))
  :     SecondaryRotaryAxis=(1)
  :     SetFormatableSymbol(RotaryAxis2, RotaryAxisName(2))
  :     SetFormatableSymbol(MiscFormat5, RotaryAxisName(2))
  :     SetFormatableSymbol(RotaryAxis2CoorOffset, RotaryAxisName(2))
  :   Else
  :     SetFormatableSign(RotaryAxis2,-1)
  :     SetFormatableSign(MiscFormat5,-1)
  :     SetFormatableSign(RotaryAxis2CoorOffset,-1)
  :   EndIf
  : EndIf
  : If (SecondaryRotaryAxis=0)
  :   RotaryAxis1Mode(Absolute360)
  : EndIf
EndDefine

## Logic to adjust clamp codes from machine setup custom settings
## Adjust these for machine specific custom settings
Define SetCustomClampCodes
  : ClampACode=(NextCLFile(XXXXX))
  : ClampBCode=(NextCLFile(XXXXX))
  : UnclampACode=(ClampACode+1)
  : UnclampBCode=(ClampBCode+1)
  : SetSymbolicCode(RotaryAxis1Clamp,   ("M"+ClampACode))
  : SetSymbolicCode(RotaryAxis1Unclamp, ("M"+UnclampACode))
  : SetSymbolicCode(RotaryAxis2Clamp,   ("M"+ClampBCode))
  : SetSymbolicCode(RotaryAxis2Unclamp, ("M"+UnclampBCode))
EndDefine

Define SetHelixOutput
 : If (HelixOutput=0)
 :   MaximumHelicalTurns=(0)
 : ElseIf (HelixOutput=1)
 :   MaximumHelicalTurns=(1)
 : ElseIf (HelixOutput=2)
 :   MaximumHelicalTurns=(99)
 : EndIf
EndDefine

Define SetRTCPMode
 : If (RTCPMode) SetSymbolicCode(WorkOffsetRTCP,"G43.5") EndIf
EndDefine

## High Speed Machining Type
##   0 = None
## Fanuc
##   101 = AI Contour Control (G05.1 Q1)
##   102 = Smooth Interpolation (G05.1 Q2)
##   103 = Nano Smoothing (G05.1 Q3)
##   104 = High Precision Contour Control (G05 P10000)
##   105 = Advance Preview Control (G08 P1)
## Mits
##   201 = High Speed Machining Mode (G05 P_)
##   202 = High Speed Accuracy Control I (G05.1 Q1)
##   203 = High Speed Accuracy Control II (G05 P10000)
##   204 = High Speed Accuracy Control III (G05 P20000)
##   205 = Spline Interpolation (G05.1 Q2)
##   206 = High Accuracy Spline Interpolation Command (G61.2)
##   207 = High Accuracy Spline Interpolation I Command (G61.4)

Define SetHighSpeedMachining
 : If (HighSpeedMachineType=101)
 :   SetSymbolicCode(MiscSymbolicCode3,"G05.1~Q1") ## R1-10 from custom setting 1 (631)
 :   SetSymbolicCode(MiscSymbolicCode5,"G05.1~Q0")
 : ElseIf (HighSpeedMachineType=102)
     ## 3xMilling Only, output warning for 5x operations and at the top of the code
 :   SetSymbolicCode(MiscSymbolicCode3,"G05.1~Q1") ## R1-10 from custom setting 1 (631), before tool offset (if R<>0)
 :   SetSymbolicCode(MiscSymbolicCode4,"G05.1~Q2~X0~Y0~Z0") ## after tool offset
 :   SetSymbolicCode(MiscSymbolicCode5,"G05.1~Q0")
 : ElseIf (HighSpeedMachineType=103)
 :   SetSymbolicCode(MiscSymbolicCode3,"G05.1~Q1") ## R1-10 from custom setting 1 (631), before tool offset (if R<>0)
 :   SetSymbolicCode(MiscSymbolicCode4,"G05.1~Q3~X0~Y0~Z0") ## Add rotary outputs for 5x ops
 :   SetSymbolicCode(MiscSymbolicCode5,"G05.1~Q0")
 : ElseIf (HighSpeedMachineType=104)
 :   SetSymbolicCode(MiscSymbolicCode3,"G05~P10000")
 :   SetSymbolicCode(MiscSymbolicCode5,"G05~P0")
 : ElseIf (HighSpeedMachineType=105)
 :   SetSymbolicCode(MiscSymbolicCode3,"G08~P1")
 :   SetSymbolicCode(MiscSymbolicCode5,"G08~P0")
 : ElseIf (HighSpeedMachineType=201)
 :   SetSymbolicCode(MiscSymbolicCode3,"G05") ## P = 1 or 2, set in custom setting 1 (631), output G61.1 automatically
 :   SetSymbolicCode(MiscSymbolicCode5,"G05~P0")
 : ElseIf (HighSpeedMachineType=202)
 :   SetSymbolicCode(MiscSymbolicCode3,"G05.1~Q1") ## No R parameter for Mits controls
 :   SetSymbolicCode(MiscSymbolicCode5,"G05.1~Q0")
 : ElseIf (HighSpeedMachineType=203)
 :   SetSymbolicCode(MiscSymbolicCode3,"G05~P10000")
 :   SetSymbolicCode(MiscSymbolicCode5,"G05~P0")
 : ElseIf (HighSpeedMachineType=204)
 :   SetSymbolicCode(MiscSymbolicCode3,"G05~P20000")
 :   SetSymbolicCode(MiscSymbolicCode5,"G05~P0")
 : ElseIf (HighSpeedMachineType=205)
 :   SetSymbolicCode(MiscSymbolicCode3,"G05~P10000") ## G05 P10000 mode must be active for G05.1 Q2 to work
 :   SetSymbolicCode(MiscSymbolicCode4,"G05.1~Q2~X0~Y0~Z0")
 :   SetSymbolicCode(MiscSymbolicCode5,"G05.1~Q0")
 : ElseIf (HighSpeedMachineType=206)
 :   SetSymbolicCode(MiscSymbolicCode3,"G05~P2") ## G05 P2 mode should be used with G61.2 mode
 :   SetSymbolicCode(MiscSymbolicCode4,"G61.2")
 :   SetSymbolicCode(MiscSymbolicCode5,"G64")
 : ElseIf (HighSpeedMachineType=207)
     ## For 3x vertical milling only, output error message if RTCP, Rotated or Dynamic offset modes are on
 :   SetSymbolicCode(MiscSymbolicCode3,"G05~P2") ## G05 P2 mode should be used with G61.4 mode
 :   SetSymbolicCode(MiscSymbolicCode4,"G61.4")
 :   SetSymbolicCode(MiscSymbolicCode5,"G64")
 : EndIf
EndDefine

## Check that necessary machine-specific custom settings exist in the machine .mprj file
Define CheckMachineSetup
  : If (ExistClFile(10060) && ExistClFile(10061)) GPAbort(ErrorMessage(10)) EndIf
  : If (ExistClFile(10080) && ExistClFile(10081)) GPAbort(ErrorMessage(11)) EndIf
  : If (ExistClFile(10060))
  :   FanucControl=(NextCLFile(10060))
  : ElseIf (ExistClFile(10061))
  :   MitsControl=(NextCLFile(10061))
  : Else
  :   GPAbort(ErrorMessage(12))
  : EndIf
    ## If machine does not include high speed machining, make sure to delete these sub routines
  : If (FanucControl && ExistCLFile(10080)=0)  GPAbort(ErrorMessage(13)) EndIf
  : If (MitsControl && ExistCLFile(10081)=0)   GPAbort(ErrorMessage(14)) EndIf
EndDefine

## Use this for control specific switches
Define SetControlParameters
  : If (MitsControl)
  :   SetFormatableSymbol(HelicalFullTurns, "P")  ## Switch L For P for Control Difference
  :   SetFormatableSymbol(MacroNumber, "H")       ## Switch Q For H for Control Difference
  : EndIf
EndDefine

## Commented out to avoid GP Abort until standard for File Revision is defined
## Define CheckMachineSetupVersion
##  If (Instring(MachineRevision, "Change To Match Your Version")) \\
##    OutputString( "(MACHINE VERSION: " + MachineRevision + ")" ) \\
##  Else \\
##    GPAbort( " ERROR: Please Load the Correct/Latest Machine Setup to use this post ") \\
##  EndIf
## EndDefine

Define OutputEndOfProgramMode
  If (EndOfProgramMode=0) \\
    RewindStop* \\
  ElseIf (EndOfProgramMode=1) \\
    EndProgram* \\
  ElseIF (EndOfProgramMode=2) \\
    MacroEnd* \\
  EndIf
EndDefine

############################# Machine Configuration ###########################

Define ToolLengthOffset
  LengthCompensation*
EndDefine

Define DiameterOffset
  DiameterCompensation*
EndDefine

############################# Operation Custom Settings #######################

## Enumeration.
## Nano Smoothing (G5.1Q3 XYZR1R2)
## Machining Condition Selection (G5.1 Q1 R) R defined in custom setting 1
##
## Custom Setting 1 for R
## When you have nano on you get G5.1 and nonZero custom setting 1 on the previous line
## When in TCP, G5.1 then TCP Then Nano
## Check R between 1 and 10
## Change dwell time drill cycles
## TestSafe Restart
##
## Moved to output before G43 instead of end link to work for all scenarios
Define HighSpeedMachiningModeOn
  : If ((CycleClass=Milling3Axis || CycleClass=Milling5Axis) && (LinkType=LinkToOperation || LinkType=LinkFromToolChange)) ## && NextCLFile(631)<>0 && HighSpeedMachON<>(NextCLFile(631)))
  :   If ((HighSpeedMachineType=101 || HighSpeedMachineType=104 || HighSpeedMachineType=105 || HighSpeedMachineType=202 || HighSpeedMachineType=203 || HighSpeedMachineType=204 || HighSpeedMachineType=205 || HighSpeedMachineType=206 || HighSpeedMachineType=207) || \\
         ((HighSpeedMachineType=102 || HighSpeedMachineType=103) && NextCLFile(631)>0) || \\
         (HighSpeedMachineType=201 && NextCLFile(631)>0) && HighSpeedMachOn=(0)) \\
        $N MiscSymbolicCode3* \\
        If (HighSpeedMachineType=101 || HighSpeedMachineType=102 || HighSpeedMachineType=103) \\
          IF (NextCLFile(631)>=1 && NextCLFile(631)<=10) MiscFormat8*(NextCLFile(631)) Else OutputString(ErrorMessage(8)) EndIf \\
        EndIf \\
        If (HighSpeedMachineType=201) \\
          IF (NextCLFile(631)=1 || NextCLFile(631)=2) MiscFormat9*(NextCLFile(631)) Else OutputString(ErrorMessage(9)) EndIf \\
        EndIf \\
        HighSpeedMachOn=(1) \\
      EndIf
  :   If (HighSpeedMachineType=201 && HighSpeedMachOn=(1)) "G61.1" EndIf
  : EndIf
EndDefine

## Output after tool comp and the beginning of the operation (EX_STARTPOINT)
Define HighAccuracyModeOn
  : If ((CycleClass=Milling3Axis || CycleClass=Milling5Axis) && (HighSpeedMachineType=(102) || HighSpeedMachineType=(103) || HighSpeedMachineType=(205) || HighSpeedMachineType=(206) || HighSpeedMachineType=(207)))
  :   If (HighSpeedMachineType=207 && (WorkOffsetTransformationCode=WorkOffsetRTCP || WorkOffsetTransformationCode=WorkOffsetRotation || WorkOffsetTransformationCode=WorkOffsetDynamic))
  :     GpAbort("WARNING: G61.4 HIGH-ACCURACY SPLINE INTERPOLATION II COMMAND IS NOT COMPATIBLE WITH 5-AXIS WORK OFFSET TRANSFORMATIONS G43.4, G68.2 OR G54.5")
  :   EndIf
  :   If (HighSpeedMachineType=102 && WorkOffsetTransformationCode=WorkOffsetRTCP)
  :     "(WARNING: G05.1 Q2 SMOOTH INTERPOLATION MODE IS NOT SUPPORTED FOR 5-AXIS MILLING OPERATIONS)"
  :     "(G05.1 Q3 NANO SMOOTHING HAS BEEN OUTPUT INSTEAD)"
  :     "G05.1 Q3 X0 Y0 Z0" If (PrimaryRotaryAxis) MiscFormat4*(0) EndIf If (SecondaryRotaryAxis) MiscFormat5*(0) EndIf HighSpeedMachOn=(1)
  :   Else
  :     $N MiscSymbolicCode4* If (HighSpeedMachineType=102 || HighSpeedMachineType=103) If (PrimaryRotaryAxis) MiscFormat4*(0) EndIf If (SecondaryRotaryAxis) MiscFormat5*(0) EndIf HighSpeedMachOn=(1) EndIf
  :   EndIf
  : EndIf
EndDefine

Define HighSpeedMachiningOff
    ## CurrentExample 1111=BeginLink
  : If (HighSpeedMachOn && (CurrentExample<>1111 || (CurrentExample=1111 && LinkType=LinkToOperation && NextCLFile(631)=0)))
  :   $N MiscSymbolicCode5*
  :   If (HighSpeedMachineType=205) "G05 P0" EndIf
  :   HighSpeedMachOn=(0)
  : EndIf
EndDefine

############################# Feed & Speed ####################################

Define CustomSpindleSpeedRPM
  If (((CurrentExample=(1111) && LinkType=LinkFromToolChange) || MRegDiff(36) || ForceMisc(36) || MRegDiff(3) || ForceMisc(3)) && ProbeTool=0)  \\
    SpindleSpeed* \\
  EndIf
EndDefine

Define CustomSpindleDirection
  If (((CurrentExample=(1111) && LinkType=LinkFromToolChange) || MRegDiff(36) || ForceMisc(36)) && ProbeTool=0) SpindleDirection* EndIf
EndDefine

Define SpRange
  If (ForceMisc(37)) SpRangeOff EndIf
##	If (NextClFile(194)<=(180)) LowRange* EndIf \\
##	If (NextClFile(194)>180 && NextClFile(194)<=450) MidRange* EndIf \\
##	If (NextClFile(194)>450 && NextClFile(194)<=1150) HighRange* EndIf \\
##	If (NextClFile(194)>=(1150)) SpRange4* EndIf \\
ENDDEFINE

Define SpindleStart
  : $N $CustomSpindleSpeedRPM $CustomSpindleDirection $SpRange
EndDefine


############################# Coolant #########################################

Define GetNextCoolantStatus
  WhileCount=(0) NextCoolantStatus=(0) \\
  While(WhileCount<=16) \\
    NextCoolantStatus=(NextCoolantStatus+NextMisc(490+WhileCount)*Exp(WhileCount*Ln(2))) \\
    WhileCount=(WhileCount+1) \\
  EndWhile \\
  NextCoolantStatus=(NextCoolantStatus+NextMisc(677)*Exp(17*LN(2)))
EndDefine

## 1      = Flood
## 2      = Mist
## 4      = Spray
## 8      = Through Spindle
## 16     = Drip
## 32     = Air
## 64     = Air Through Spindle
## 128    = Custom 1
## 256    = Custom 2
## 512    = Custom 3
## 1024   = Custom 4
## 2048   = Custom 5
## 4096   = Custom 6
## 8192   = Custom 7
## 16384  = Custom 8
## 32768  = Custom 9
## 65536  = Custom 10
## 131072 = High Pressure

Define FloodCoolantUsed
  (((NextCoolantStatus/1)%2)>0)
EndDefine

Define MistCoolantUsed
  (((NextCoolantStatus/2)%2)>0)
EndDefine

Define ThroughSpindleCoolantUsed
  (((NextCoolantStatus/8)%2)>0)
EndDefine

Define Custom1CoolantUsed
  (((NextCoolantStatus/128)%2)>0)
EndDefine

Define Custom2CoolantUsed
  (((NextCoolantStatus/256)%2)>0)
EndDefine

Define HighPressureCoolantUsed
  (((NextCoolantStatus/131072)%2)>0)
EndDefine

Define SharedCoolantOff
  If ($FloodCoolantUsed || $MistCoolantUsed || $ThroughSpindleCoolantUsed || $HighPressureCoolantUsed || $Custom1CoolantUsed || $Custom2CoolantUsed) \\
    $N CoolantFloodOff* CoolantMistOff! CoolantThroughSpindleOff! CoolantHighPressureOff! CoolantCustom1Off!  CoolantCustom2Off! \\
  EndIf
EndDefine

Define TurnOnCoolant
    If (OutputCoolantCode && ProbeTool=0)
  :   If (NextCLFile(6799))
  :     $GetNextCoolantStatus
  :     If ((PresMisc(493) && (MRegDiff(490) || MRegDiff(493))) || \\ ## M7 is on and M8 is being turned on or M7 is being turned off
            (PresMisc(497) && (MRegDiff(490) || MRegDiff(497))) || \\ ## M59 is on and M8 is being turned on or M59 is being turned off
            (PresMisc(677) && (MRegDiff(490) || MRegDiff(677))))   ## M52 is on and M8 is being turned on ((PresMisc(677) && $ThroughSpindleCoolantUsed) || (PresMisc(493) && $HighPressureCoolantUsed))
  :       $SharedCoolantOff
  :     EndIf
  :     If (NextCLFile(7101) && CoolantStatus<>NextCoolantStatus)
  :       $N CoolantOffCodes(1)
  :       $N CoolantOffCodes(1)
  :       $N CoolantOffCodes(1)
  :       $N CoolantOffCodes(1)
  :       $N CoolantOffCodes(1)
  :       $N CoolantOffCodes(1)
  :       $N CoolantOffCodes(1)
  :       $N CoolantOffCodes(1)
  :       $N CoolantOffCodes(1)
  :       $N CoolantOffCodes(1)
  :     EndIf
  :     If ($HighPressureCoolantUsed)
  :       $N If (MRegDiff(677) || MRegDiff(481)) CoolantPressureCode* EndIf CoolantHighPressureOn!
  :     EndIf
  :     $N CoolantCodes(1)
  :     $N CoolantCodes(1)
  :     $N CoolantCodes(1)
  :     $N CoolantCodes(1)
  :     $N CoolantCodes(1)
  :     $N CoolantCodes(1)
  :     $N CoolantCodes(1)
  :     $N CoolantCodes(1)
  :     $N CoolantCodes(1)
  :     $N CoolantCodes(1)
  :     If ($ThroughSpindleCoolantUsed || $HighPressureCoolantUsed) ThroughSpindleCoolantWasUsed=(1) EndIF
  :     CoolantStatus=(NextCoolantStatus) OutputCoolantCode=(0)
  :   Else
  :     If (NextCLFile(214)>=5) $N M8* EndIf
  :     $N CoolantCode*
  :     If (NextCLFile(214)=4) $N "M15" EndIf ## Flood 2
  :     CoolantStatus=(NextCLFile(214)) OutputCoolantCode=(0)
  :   EndIf
  : EndIf
EndDefine

Define TurnOffCoolant
  : If (NextCLFile(6799))
  :   If (CoolantStatus)
  :     If (($ThroughSpindleCoolantUsed || $HighPressureCoolantUsed || $Custom1CoolantUsed || $Custom2CoolantUsed) && PresMisc(36)<>0) $N SpindleOff* EndIf
  :     $SharedCoolantOff
  :     $N CoolantCodes(1)
  :     $N CoolantCodes(1)
  :     $N CoolantCodes(1)
  :     $N CoolantCodes(1)
  :     $N CoolantCodes(1)
  :     $N CoolantCodes(1)
  :     $N CoolantCodes(1)
  :     $N CoolantCodes(1)
  :     $N CoolantCodes(1)
  :     $N CoolantCodes(1)
  :     ## If ($ThroughSpindleCoolantUsed || $HighPressureCoolantUsed)
        ##   $FlushAirThroughSpindle
  :     ## EndIf
  :     CoolantStatus=(0)
  :   EndIf
  : Else
  :   If (CoolantStatus<>0) $N CoolantOff* EndIf
  :   If (CoolantStatus>=5)
  :     If (PresMisc(36)<>0) $N SpindleOff* EndIf
  :     ## $N CoolantAirThroughSpindleOn* ## Air Blow On
  :     ## $N DwellTime2*(3)
  :     ## $N CoolantAirThroughSpindleOff* ## Air Blow Off
  :   EndIf
  :   CoolantStatus=(0)
  : EndIf
EndDefine

############################# Tool Change #####################################

Define ResetModalCommands
    ## Miscellaneous Register index numbers; 22=MotionCode, 23=CoordinateCode, 27=WorkPlaneCode, 36=SpindleDirection, 40=FeedUnit, 41=SpindleUnit, 171=WorkSystem, 273=SecWorkSystem
    ## ClampCodes; 401=PrimaryAxis1(A/B), 402=PrimaryAxis2(C)
  : Incremental! ForceMisc(22)=(1) ForceMisc(23)=(1) ForceMisc(27)=(1) ForceMisc(36)=(1) ForceMisc(40)=(1) \\
    If (NextClFile(7227)=0) ForceMisc(171)=(1) ElseIf (NextCLFile(7227)=1) ForceMisc(273)=(1) EndIf \\
    If (PrimaryRotaryAxis) ForceMisc(401)=(1) EndIf If (SecondaryRotaryAxis) ForceMisc(402)=(1) EndIf \\
    Feedrate!(0) ChipFeedrate!(0) SpindleSpeed!(0)
EndDefine

## Function used to set correct scale based on file & tool unit
Define ToolUnScale
  If (NextCLFile(141)<>NextCLFile(813)) \\  ## File unit & tool unit do not match
    If (NextCLFile(141)<NextCLFile(813)) \\  ## File unit is in inch but tool in metric
      ToolUnScale=(25.4) \\
    Else \\  ## File is in metric but tool in inch
      ToolUnScale=(1/25.4) \\
    EndIf \\
  Else \\  ## File unit & tool unit match
    ToolUnScale=(1) \\
  EndIf
EndDefine

Define OutputNextTool
  If (NextTool<>0) ToolNumber*(NextTool) "(<<< NEXT TOOL >>>)" Else If (PresentTool<>FirstTool) ToolNumber*(FirstTool) "(<<< NEXT TOOL >>>)" EndIf EndIf
EndDefine

Define OperationName
   If (OpNameWasOutput=0 && StringLength(NextCLFile(613))) OutputString("("+UpperCaseString(CLString(613))+")") OpNameWasOutput=(1) EndIf
EndDefine

Define ToolChange
  : FixedZ=(999) GMode=(0)
    $ResetModalCommands
  : $ToolUnScale
  : $OutputToolChangeSequenceNumber $OperationName
    Comment
  : If (NextCLFile(1772)=1)
  :   $N MotionRapid If (LengthCompEnabled=43.4) WorkOffsetRTCPOff* EndIf LengthCompEnabled=(0) Incremental ZeroReturn HomeReturnZ*
  : ElseIf (NextCLFile(1772)=3)
  :   $N MotionRapid Absolute If (LengthCompEnabled=43.4) WorkOffsetRTCPOff* EndIf LengthCompEnabled=(0) CoordinatePreset* MiscFormat3*(ZTC)
  : EndIf
  : $N MotionRapid* XYPlane* MeasurementCode* CompensationOff* Cancel* Absolute* FeedUnit*
  : $N If (NextCLFile(117)<>1 && NextCLFile(1772)<>3 && LengthCompEnabled=43.4) WorkOffsetRTCPOff* EndIf LengthCompEnabled=(0) ToolChange* ToolNumber* If (MitsControl && PreStageNextTool=1) $OutputNextTool EndIf "(CLString(498))" ## If (PrimaryRotaryAxis && SecondaryRotaryAxis) WorkOffsetRTCPOff* EndIf LengthCompEnabled=(0)
  : ToolChangeComment
  : $N If (PreStageNextTool=2) $OutputNextTool EndIf
  : If (NextClFile(110)=28) ProbeTool=(1) Else ProbeTool=(0) EndIf
  : TC=(1)
EndDefine

Define OutputToolCancelStopCode
  If (ToolCancelStopCode=1) \\
    $N OptionalStop* \\
  ElseIf (ToolCancelStopCode=2) \\
    $N ProgramStop* \\
  EndIf
EndDefine

############################# Motion ##########################################

Define OutputCircularInterpolation
  If     (CircularInterpolation=0) XCenterAbsolute* YCenterAbsolute* HelicalFullTurns \\
  ElseIf (CircularInterpolation=1) XCenterAbsolute* YCenterAbsolute* HelicalFullTurns $RSpOn " (" CircleRadius* ")" $RSpOff \\
  ElseIf (CircularInterpolation=2) CircleRadius* \\
  EndIf
EndDefine

Define OutputCircularInterpolationZX
  If     (CircularInterpolation=0) XCenterAbsolute* ZCenterAbsolute* HelicalFullTurns \\
  ElseIf (CircularInterpolation=1) XCenterAbsolute* ZCenterAbsolute* HelicalFullTurns $RSpOn " (" CircleRadius* ")" $RSpOff \\
  ElseIf (CircularInterpolation=2) CircleRadius* \\
  EndIf
EndDefine

Define OutputCircularInterpolationYZ
  If     (CircularInterpolation=0) YCenterAbsolute* ZCenterAbsolute* HelicalFullTurns \\
  ElseIf (CircularInterpolation=1) YCenterAbsolute* ZCenterAbsolute* HelicalFullTurns $RSpOn " (" CircleRadius* ")" $RSpOff \\
  ElseIf (CircularInterpolation=2) CircleRadius* \\
  EndIf
EndDefine

############################# Work OffSet / Transformation ####################

Define BaseWorkOffset
  If (NextCLFile(7227)=0) \\
    WorkSystem \\
  ElseIf (NextCLFile(7227)=1) \\
    SecWorkSystem \\
  Else \\
    GpAbort(ErrorMessage(4)) \\
  EndIf
EndDefine

Define OutputDynamic2
  If (DelayDynamicOffset && NextCLFile(14008)=2) \\
    WorkOffsetDynamic! DynamicOffsetNumber* DelayDynamicOffset=(0) \\
  EndIf
EndDefine

Define OutputWSEC
  If (NextCLFile(14008)=3 && NextMisc(442)>0) \\
    WorkOffsetDynamic! DynamicOffsetNumber \\
  EndIf
EndDefine

Define OutputLengthComp
  WOutputWithLengthComp=(0) \\ ## ACF 2026/11/20 Case 02650943
  If (LengthCompEnabled=0 || EnableRTCP) \\
    If (ForceDim(3)) \\
      If (EnableRTCP) \\
        WorkOffsetRTCP* EnableRTCP=(0) LengthCompEnabled=(43.4) \\
      Else \\
        CompensationPlus* LengthCompEnabled=(43) WC1LinearAxis1 WOutputWithLengthComp=(1) \\ ## ACF 2026/11/20
      EndIf \\
      $ToolLengthOffset \\
    EndIf \\
  EndIf
EndDefine

Define WOTRotateOn
 : $N WorkOffsetRotation* If (AngleRotationMode=1) "P1" EndIf MiscFormat1*(XLocalOffset) MiscFormat2*(YLocalOffset) MiscFormat3*(ZLocalOffset) \\
   If (AngleRotationMode=0) EulerGammaAngle* EulerBetaAngle* EulerAlphaAngle* Else RollAngle* PitchAngle* YawAngle* EndIf
 : $N "G53.1" If (MitsControl) If (NextDim(63)+NextCLFile(3913)>=0) "P1" Else "P2" EndIf EndIf "(" RotaryAxis1* RotaryAxis2* ")" ## Output absolute rotary positions as reference
EndDefine

Define WorkOffsetTransformation
  : If (WorkOffsetTransformationCode=WorkOffsetTranslation)
  :   $N WorkOffsetTranslation XTranslation* YTranslation* ZTranslation*
  : ElseIf (WorkOffsetTransformationCode=WorkOffsetRotation)
  :   $N If (PresMisc(23)=91) Absolute EndIf
      $WOTRotateOn
  : Else (WorkOffsetTransformationCode=WorkOffsetRTCP)
  :   EnableRTCP=(1)
  : EndIf
EndDefine

Define StopSpindle
  If (LinkType=LinkToToolCancel || LinkType=LinkFinal) \\
    If (PresMisc(36)<>0) $N SpindleOff* EndIf \\
  EndIf
EndDefine

############################# Work Offset List ################################

Define StartWCListComment
  If (OutputWorkOffsetList=1) "(" EndIf
EndDefine

Define EndWCListComment
  If (OutputWorkOffsetList=1) ")" EndIf
EndDefine

Define OutputWorkOffsetListItem
  : If (OutputWorkOffsetList)
  :   $StartWCListComment MiscSymbolicCode1* \\
      If (NextCLFile(756)=0) \\
        "L2" MiscFormat7*(NextCLFile(755)-53) \\
      ElseIf (NextCLFile(756)<>0) \\
        "L20" MiscFormat7*(NextClFile(756)) \\
      EndIf \\
      XCoorOffset* YCoorOffset* ZCoorOffset* \\
      If (NextCLFile(3924)) If (PrimaryRotaryAxis) RotaryAxis1CoorOffset* EndIf If (SecondaryRotaryAxis) RotaryAxis2CoorOffset* EndIf EndIf \\
      $EndWCListComment "(CLString(754))"
  :   WorkCoorComment
  : EndIf
EndDefine

Define OutputDynamicOffsetListItem
  : If (OutputWorkOffsetList)
  :   $StartWCListComment MiscSymbolicCode1* "L21" MiscFormat7*(NextClFile(7218)) XDynamicOffset* YDynamicOffset* ZDynamicOffset* $EndWCListComment "(CLString(7217))"
  : EndIf
EndDefine

############################# Collinear Axes ################################

Define SetCollinearAxisConfiguration
  : WhileCount=(1)
  : While (WhileCount<=AxisCount && AxisName<>"")
  :   AxisName=(AxisNameFromIndex(WhileCount))
  :   If (ClfileAxis(7067,AxisName)=5 || ClfileAxis(7067,AxisName)=6) ## Check if AxisType is Linear
  :     If (ClfileAxis(7074, AxisName)<>0)  ## Check if Uz is NonZero
  :       CollinearAxisCount=(CollinearAxisCount+1)
  :       CollinearAxisName(CollinearAxisCount)=(AxisName)
  :       If (CollinearAxisCount>1) ExistCollinearAxes=(1) EndIf
  :     EndIf
  :   EndIf
  :   WhileCount=(WhileCount+1)
  : EndWhile
EndDefine

Define ReEnableW
  : If (WAxEnable(OpNumber-1)<>0 && WAxEnable(OpNumber)<>WAxEnable(OpNumber-1) && WAxEnable(OpNumber)<>0 && WAxEnable(OpNumber-1)<>9999)
  :   $N MotionRapid* Incremental* ZeroReturn* HomeReturnZ*
  :   $N
  :   LengthCompEnabled=(0) ReEnableW=(1)
  : EndIf
EndDefine

#############################################################################################################
############################# Examples ######################################################################
#############################################################################################################

Ex_Setup                : $ErrorMessages

Ex_StartCode            :
                          ## $CheckMachineSetup
                          $SetControlParameters
                          $CheckMachineSetupVersion
                          $SetStandardCustomSettingVariables
                          $SetSafeRestartMode
                          $SetDynamicOffsetType
                          $SetNCodeIncrement
                          $SetMachineTolerances
                          $SetLinearAxesPrecision
                          $SetProbingLinearAxesPrecision
                          $SetRotaryConfiguration
                          $SetProbingRotaryAxesPrecision
                      ##  $SetCustomClampCodes  ## Turn on if custom clamp code settings exist in the machine setup
                          $SetHelixOutput
                          $SetRTCPMode
                          $SetHighSpeedMachining
                          $SetMachineSpecificCustomSettings
                          $SetCollinearAxisConfiguration
                        : PercentSign*
                        : O* $RSpOn "(" ProgramName* ")" $RSpOff
                        : If (StringLength(CLString(1452))) OutputString("("+UpperCaseString(CLString(1452))+")") EndIf ## Machine Name
                        : OutputString("( ESPRIT TNG VERSION - "+ EspritVersion+ " )" )
                        : If (StringLength(MachineRevision))  ## Checks to see if machine revision had been entered. If returns 0 Skips.
                        :   OutputString("( MACHINE VERSION - "+ MachineRevision+ " )" )
                        : EndIf
                        : TimeStamp
                        : ProgramComment
                        : BlankLine

Ex_MainStart            : SequenceNumber!(0)

Ex_MachineSetup         : $N MotionRapid* XYPlane* MeasurementCode* CompensationOff* WorkOffsetRTCPOff* Cancel* Absolute* FeedPerMinute*
                        : $N If (NextCLFile(14032)=3) CoordinatePreset* Else Incremental* ZeroReturn* EndIf MiscFormat3*(0) WC1LinearAxis1*(0)
                        : $N If (NextCLFile(14032)=3) CoordinatePreset* Else Incremental* ZeroReturn* EndIf
                        : $N If (NextCLFile(14032)=3) CoordinatePreset* Else Incremental* ZeroReturn* EndIf MiscFormat1*(0) MiscFormat2*(0)
                        : If (PrimaryRotaryAxis) $N RotaryAxis1UnClamp EndIf
                        : If (SecondaryRotaryAxis) $N RotaryAxis2UnClamp EndIf
                        : If (PrimaryRotaryAxis || SecondaryRotaryAxis) $N If (NextCLFile(14032)=3) CoordinatePreset* Else Incremental* ZeroReturn* EndIf EndIf \\
                          If (PrimaryRotaryAxis)  MiscFormat4*(0) ForceDim(63)=(1) EndIf \\
                          If (SecondaryRotaryAxis)  MiscFormat5*(0) ForceDim(64)=(1) EndIf
                        : If (NextCLFile(14032)<>3) $N Absolute* EndIf
                        : $N OptionalStop*
                        : BlankLine

Ex_BeforeCycle          : If (TC<=0)
                        :   If (TC<0)
                              $ToolChange $OperationName
                        :   EndIf
                        : Else
                        :   $NAtOperation $N $OperationName
                        :   Comment
                        : EndIf
                        : OpNumber=(OpNumber+1) ## Because OperationNumber returns the internal element number and not what's listed in the part list, I made my own counter for error messages
                        : If (ExistCLFileCycle(3321) && NextCLFile(3321)) CLFileMode(CLNormal) Else CLFileMode(CLCompressed) EndIf

Ex_FirstToolChange        $ToolChange

Ex_OtherToolChange        $ToolChange

Ex_LastToolChange         $ToolChange

############################# Link Examples #################################################################

## LinkType values
##   * 0 - LinkNotActive      - Missing link this value is for trapping an error with a link.
##   * 1 - LinkFromToolChange - Link from tool change to start of an operation.
##   * 2 - LinkToToolCancel   - Link at the end of an operation to go to the tool change position.
##   * 3 - LinkToOperation    - Approach link to start point of an operation between 2 operations using the same tool.
##   * 4 - LinkFromOperation  - Retract link of an operation between 2 operations using the same tool.
##   * 5 - LinkFinal          - Final link of the program.
##   * 6 - LinkBetweenHoles   - Link between holes of a hole machining operation
##   * 7 - LinkToPark         - Link to a Park position of a park cycle
##   * 8 - LinkFromPark       - Link from a Park position of a park cycle to an operation with the same tool

Ex_Begin_Link           : If (SecondaryRotaryAxis=0) MaxRotaryAxis1Increment(0) Else MaxRotaryAxis2Increment(0) EndIf
                        : If (ToolRadiusComp3D) CompensationOff* ToolRadiusComp3D=(0) SetSymbolicCode(CompensationLeft,"G41") SetSymbolicCode(CompensationRight,"G42") EndIf
                        : If (MRegDiff(8) && LinkType=LinkToOperation) LengthCompEnabled=(0) EndIf
                        : If (Is_Axis_Fixed("Z")) ## If Z is fixed
							  				:     SetFormatableOffset(TC1LinearAxis2,NextCLFile(3912)) SetFormatableSymbol(TC1LinearAxis2, "G200 Z")
 						  				  : EndIf
                        ##  $SpindleStart  ## ACF 2026/11/23 Case 02650943
                        : $N $BaseWorkOffset If (PresMisc(23)=91) Absolute EndIf
                        : $N $OutputWSEC
                          $HighSpeedMachiningOff
                        : If (LinkType=LinkFromToolChange || LinkType=LinkToOperation || LinkType=LinkToPark)
                        :   If (NextCLFile(6799)) $GetNextCoolantStatus EndIf
                        :   If ((NextCLFile(6799)=0 && CoolantStatus<>CoolantCode && CoolantCode>=5) || (NextCLFile(6799) && ((NextCLFile(7101) && CoolantStatus<>NextCoolantStatus) || $ThroughSpindleCoolantUsed || $Custom1CoolantUsed || $Custom2CoolantUsed))) ## ($ThroughSpindleCoolantUsed || $HighPressureCoolantUsed)))
                        :     OutputCoolantCode=(1)
                        :     $TurnOnCoolant
                        :   EndIf
                        : EndIf
                        : If (CoolantOutputLocation=1 && ((NextCLFile(6799)=0 && CoolantStatus<>CoolantCode && CoolantCode>=5) || (NextCLFile(6799) && CoolantStatus<>NextCoolantStatus)) && (LinkType=LinkFromToolChange || LinkType=LinkToOperation))
                        :   OutputCoolantCode=(1)
                        :   $TurnOnCoolant
                        : EndIf

Ex_Activate_Work_Offset_Transformation :
                        : If (WorkOffsetTransformationCode=WorkOffsetRotation)
                            ## Next line added for when there is a rotary angle change between operations or orientations on a 5-Axis drilling operations that
                            ## exceeds the maximum rotary angle change value where an axis is home.  Ensures G90 is modal for the subsequent G68.2.
                        :   If (PresMisc(23)=91) $N Absolute EndIf
                        :   ## Because the system doesn't know a rotate transformation rotates the rotary axes with the G53.1 command, We
                        :   ## have to delay the work offset transformation to Ex_Link_Rapid_Position. To get unclamp, transformation,
                        :   ## clamp, XY, Z output from tool change.  The following logic prevents MotionRapid output during the delay and
                        :   ## saves it until the upcoming XY positioning.
                        :   DelayWorkOffsetTrans=(1)
                        : Else
                            $WorkOffsetTransformation
                        : EndIf

Ex_Activate_Dynamic_Offset :
                        : If (NextClFile(14008)<=2)
                        :   If (NextClFile(14008)=2) DelayDynamicOffset=(1) Else WorkOffsetDynamic! DynamicOffsetNumber* EndIf
                        : ElseIf (NextClFile(14008)=3)
                        :   ## WorkOffsetDynamic! DynamicOffsetNumber*
                        : EndIf

## Only used for RTCP links
Ex_Link_Feed_Position   : $N MotionLinear $OutputLengthComp Absolute FeedUnit XAbsolute YAbsolute TC1LinearAxis2 RotaryAxis1 RotaryAxis2 FeedRateCode

Ex_Link_Rapid_Position  : $StopSpindle
                        : If (DelayWorkOffsetTrans)
                            $WorkOffsetTransformation
                        :   DelayWorkOffsetTrans=(0)
                        : EndIf
                        : If (CoolantOutputLocation=0 && ForceDim(3)) OutputCoolantCode=(1) EndIf
                        : If (WorkOffsetTransformationCode=WorkOffsetRTCP)
                        :   $N If (MRegDiff(40)=1) FeedUnit EndIf ## Machine requires IPM to be modal before enabling RTCP
                        :   $TurnOnCoolant
                        : EndIf
                          $HighSpeedMachiningModeOn
                        :   $N MotionRapid $OutputDynamic2 $OutputLengthComp $BaseWorkOffset Absolute XAbsolute YAbsolute If (WOutputWithLengthComp=0) WC1LinearAxis1 EndIf TC1LinearAxis2 RotaryAxis1 RotaryAxis2 RotaryAxis3! \\ ## ACF 2026/11/20 Case 02650943


Ex_Link_Rapid_Home      : $StopSpindle
                        : If (LinkType=LinkToToolCancel || LinkType=LinkFinal)
                            $TurnOffCoolant
                        : EndIf
                          $HighSpeedMachiningOff
                        : $N MotionRapid If (LengthCompEnabled=43.4) WorkOffsetRTCPOff* LengthCompEnabled=(0) EndIf Incremental ZeroReturn HomeReturnCode* WC1LinearAxis1

Ex_Link_Rapid_Machine     $HighSpeedMachiningOff
                        : $StopSpindle
                        : If (LinkType=LinkToToolCancel || LinkType=LinkFinal)
                            $TurnOffCoolant
                        : EndIf
                        : If (NextCLFile(14005)=3 && (LinkType=LinkToToolCancel || LinkType=LinkFinal) && LinkMachineZ) XAbsolute! YAbsolute! ExitExample EndIF
                        : $N MotionRapid Absolute If (LengthCompEnabled=43.4) WorkOffsetRTCPOff* LengthCompEnabled=(0) EndIf CoordinatePreset* XAbsolute YAbsolute TC1LinearAxis2 WC1LinearAxis1 RotaryAxis1 RotaryAxis2
                        : If (NextDim(3)=0) LinkMachineZ=(1) EndIf  ## LinkHomeZ doesn't return the correct value in Link_Rapid_Machine

Ex_Deactivate_Work_Offset_Transformation  $HighSpeedMachiningOff
                        : If (WorkOffsetTransformationCode=WorkOffsetRotationOff)
                        :   If (LengthCompEnabled) $N LengthCancel* LengthCompEnabled=(0) EndIf ## Otherwise PS5462 alarm at next G68.2
                        : ElseIf (WorkOffsetTransformationCode=WorkOffsetRTCPOff)
                        :   LengthCompEnabled=(0)
                            $SetHelixOutput
                        : EndIf
                        : $N WorkOffsetTransformationCode*

Ex_Deactivate_Dynamic_Offset :
                        : WorkOffsetDynamicOff!
                        : $N DynamicOffsetNumber*(0) LengthCompEnabled=(0)


Ex_Clamping             : If (PrimaryRotaryAxis && SecondaryRotaryAxis && ((ForceMisc(401) || MRegDiff(401)) && (ForceMisc(402) || MRegDiff(402))) && (NextMisc(401)=NextMisc(402) || (NextMisc(401) && NextMisc(402)=0) || (NextMisc(401)=0 && NextMisc(402))))
                        :   RotaryAxis1ClampCode! RotaryAxis2ClampCode! RotaryAxis3ClampCode!
                        : Else
                        :   If (PrimaryRotaryAxis) $N RotaryAxis1ClampCode EndIf
                        :   If (SecondaryRotaryAxis) $N RotaryAxis2ClampCode EndIf
                        :   RotaryAxis3ClampCode!
                        : EndIf

Ex_End_Link             : If (((CoolantOutputLocation=2 && NextCLFile(6799)=0 && CoolantStatus<>CoolantCode) || NextCLFile(6799)) && (LinkType=LinkFromToolChange || LinkType=LinkToOperation))
                        :   OutputCoolantCode=(1)
                        :   $TurnOnCoolant
                        : EndIf
                        : If (SecondaryRotaryAxis=0) MaxRotaryAxis1Increment(179.999) Else MaxRotaryAxis2Increment(179.999) EndIf
                        : If (PresMisc(23)=91) $N Absolute EndIf
                        : LinkMachineZ=(0)

#############################################################################################################

Ex_StartPoint           : If (ExistCLFileCycle(1284) && NextCLFile(1284) && (ExistCLFileCycle(234) || ExistCLFileCycle(6822)) && ToolRadiusComp3D=0)
                        :   ToolRadiusComp3D=(1)
                            ## Following line : everything needs to be forced out on the first 3D compensation move
                        :   ForceMisc(7)=(1) ForceMisc(34)=(1) ## Diameter Compensation, CompensationSide
                        :   ForceDim(1)=(1) ForceDim(2)=(1) ForceDim(3)=(1) ## X, Y, Z
                        :   ForceDim(63)=(1) ForceDim(64)=(1) ## Rotary1, Rotary2
                        :   If (WorkOffsetTransformationCode=WorkOffsetRTCP)
                        :     If (RTCPMode) ## RTCP Vectors
                        :       SetSymbolicCode(CompensationLeft,"G41.6") SetSymbolicCode(CompensationRight,"G42.6")
                        :     Else
                        :       SetSymbolicCode(CompensationLeft,"G41.2") SetSymbolicCode(CompensationRight,"G42.2")
                        :     EndIf
                        :   EndIf
                        : EndIf
                        : If (WorkOffsetTransformationCode=WorkOffsetDynamic && CycleClass=Milling5Axis && NextCLFile(193)<>5)
                        :   GpAbort(ErrorMessage(1) + "  Operation Number " + OpNumber)
                        : ElseIf (WorkOffsetTransformationCode=WorkOffsetRTCP && CycleType<>3 && NextCLFile(193)=2)
                        :   GpAbort(ErrorMessage(2) + "  Operation Number " + OpNumber)
                        : ElseIf (WorkOffsetTransformationCode=WorkOffsetRotation && SecondaryRotaryAxis=0)
                        :   OutputString(ErrorMessage(5) + "  Operation Number " + OpNumber)
                        : ElseIf (WorkOffsetTransformationCode=WorkOffsetRTCP && NextCLFile(10021)=1 && NextCLFile(3317)<>1)
                        :   GpAbort(ErrorMessage(7))
                        : EndIf
                        : If (ProbeTool=0)
                            $SpindleStart ## ACF 2026/11/23 Case 02650943
                        : EndIf
                          $HighAccuracyModeOn
                        : If (WorkOffsetTransformationCode=WorkOffsetRTCP) MaximumHelicalTurns=(0) EndIf

Ex_Rapid                : $N MotionRapid $OutputLengthComp XAbsolute YAbsolute TC1LinearAxis2 If (WOutputWithLengthComp=0) WC1LinearAxis1 EndIf RotaryAxis1 RotaryAxis2 ## ACF 2026/11/20 Case 02650943

Ex_Linear               : $N MotionLinear $OutputLengthComp FeedUnit XAbsolute YAbsolute TC1LinearAxis2 If (WOutputWithLengthComp=0) WC1LinearAxis1 EndIf RotaryAxis1 RotaryAxis2 FeedRateCode ## ACF 2026/11/20 Case 02650943

Ex_Circle               : $N CircleDirection WorkPlaneCode FeedUnit XAbsolute* YAbsolute* ZAbsolute! TC1LinearAxis2 WC1LinearAxis1 $OutputCircularInterpolation FeedRateCode

Ex_CircleZX             : $N CircleDirection WorkPlaneCode FeedUnit XAbsolute* YAbsolute TC1LinearAxis2 WC1LinearAxis1 $OutputCircularInterpolationZX FeedRateCode

Ex_CircleYZ             : $N CircleDirection WorkPlaneCode FeedUnit XAbsolute YAbsolute* TC1LinearAxis2 WC1LinearAxis1 $OutputCircularInterpolationYZ FeedRateCode

Ex_Compensation         : $N MotionLinear WorkPlaneCode CompensationSide* FeedUnit XAbsolute YAbsolute TC1LinearAxis2 WC1LinearAxis1 RotaryAxis1 RotaryAxis2 $DiameterOffset FeedRateCode

Ex_CompensationOff      : $N MotionLinear CompensationOff* XAbsolute YAbsolute TC1LinearAxis2 WC1LinearAxis1 RotaryAxis1 RotaryAxis2 FeedRateCode

Ex_CompOff_R            : $N MotionRapid CompensationOff* XAbsolute YAbsolute TC1LinearAxis2 WC1LinearAxis1 RotaryAxis1 RotaryAxis2

Ex_CycleStart						:	$N $OperationName

Ex_CycleEnd             : If (SafeRestart)
                        :   ## $N If (WorkOffsetTransformationCode=WorkOffsetRotation) WorkOffsetRotationOff* ElseIf (WorkOffsetTransformationCode=WorkOffsetRTCP) WorkOffsetRTCPOff* LengthCompEnabled=(0) EndIf
                        :   TC=(-1)
                        : EndIf
                        : OpNameWasOutput=(0)

Ex_ToolCancel           : If (Is_Axis_Fixed("Z")) $N "G200" EndIf
                        : If (LastCycle=0)
                        :   $OutputToolCancelStopCode
                        :   BlankLine
                        : EndIf
                        : TC=(0)

Ex_MainEnd              : Blankline
                        : If (PrimaryRotaryAxis || SecondaryRotaryAxis) $N MotionRapid* CoordinatePreset* EndIf \\
                          If (PrimaryRotaryAxis) MiscFormat4*(0) EndIf \\
                          If (SecondaryRotaryAxis) MiscFormat5*(0) EndIf
                        : $N If (NextCLFile(10031)<>0 && PresentTool<>FirstTool) ToolChange* EndIf
                        : $N $OutputEndOfProgramMode

Ex_EndCode              : %

Ex_AuxCycle             : $N InlineNCString

Ex_TechnologyChange     : $N Comment
                        : $N SpindleSpeed SpindleDirection
                        : $N CoolantCodes(1)
                        : $N CoolantCodes(1)
                        : $N CoolantCodes(1)
                        : $N CoolantCodes(1)
                        : $N CoolantCodes(1)
                        : $N CoolantCodes(1)
                        : $N CoolantCodes(1)
                        : $N CoolantCodes(1)
                        : $N CoolantCodes(1)
                        : $N CoolantCodes(1)
                        : $N CoolantCodes(1)
                        : $N CoolantCodes(1)
                        : $N CoolantCodes(1)
                        : $N CoolantCodes(1)
                        : $N CoolantCodes(1)
                        : $N CoolantCodes(1)
                        : $N CoolantCodes(1)
                        : $N CoolantCodes(1)
                        : $N DwellTime2
                        : $N ProgramMode

Ex_TechnologyChange2    : Comment
                        : $N ProgramMode

Ex_Park                 : $N InLineNCString
                        : $N ProgramMode
                        : If (ProgramMode=ProgramStop || ProgramMode=OptionalStop) BlankLine TC=(-1) EndIf ## if stop code is Stop or Optional Stop, full restart is output afterwards

############################# 5-Axis Machining ##############################################################

Ex_Rapid_5Axis          : If (SecondaryRotaryAxis=0) MaxRotaryAxis1Increment(0) Else MaxRotaryAxis2Increment(0) EndIf
                        : $N MotionLinear FeedUnit XAbsolute YAbsolute TC1LinearAxis2 WC1LinearAxis1 \\
                          If (RTCPMode) \\
                            ToolVectorX* ToolVectorY* ToolVectorZ* RotaryAxis1! RotaryAxis2! \\
                          Else \\
                            RotaryAxis1 RotaryAxis2 \\
                          EndIf \\
                          FeedRateCode(NextCLFile(7041))

Ex_Linear_5Axis         : If (ToolRadiusComp3D)
                        :   $N MotionLinear \\
                            If ((ExistCLFileCycle(234) && NextCLFile(234)=1) || (ExistCLFileCycle(6822) && NextCLFile(6822)=1)) CompensationLeft* Else CompensationRight* EndIf \\
                            DiameterCompensation(PresentTool) FeedUnit XAbsolute YAbsolute TC1LinearAxis2 WC1LinearAxis1 RotaryAxis1 RotaryAxis2 FeedRateCode
                        : Else
                        :   $N MotionLinear FeedUnit XAbsolute YAbsolute TC1LinearAxis2 WC1LinearAxis1 \\
                            If (RTCPMode) \\
                              ToolVectorX* ToolVectorY* ToolVectorZ* RotaryAxis1! RotaryAxis2! \\
                            Else \\
                              RotaryAxis1 RotaryAxis2 \\
                            EndIf \\
                            FeedRateCode
                        : EndIf


############################# List Examples #################################################################

Ex_Begin_Declare_ToolDefinitions :
                        : If (OutputToolList)
                        :   "(******************* TOOL LIST *******************)"
                        : EndIf

Ex_ToolDefinition       : If (OutputToolList)
                        :   "(" T* OutputString(UpperCaseString(CLString(498))+")")
                        ##:   ToolChangeComment
                        : EndIf

Ex_End_Declare_ToolDefinitions :
                        : If (OutputToolList)
                        :   "(*************************************************)"
                        :   BlankLine
                        : EndIf

Ex_Begin_Declare_CycleDefinitions :
                        : If (OutputOperationList)
                        :   "(******************* OPERATION LIST *******************)"
                        : EndIf

Ex_CycleDefinition      : If (OutputOperationList)
                        :   "(" OutputString(UpperCaseString(CLString(613))+")")
                        : EndIf

Ex_End_Declare_CycleDefinitions :
                        : If (OutputOperationList)
                        :   "(*************************************************)"
                        :   BlankLine
                        : EndIf

Ex_Begin_Declare_WorkCoDefinitions :
                        : If (OutputWorkOffsetList)
                        :   "(**************** WORK OFFSET LIST ***************)"
                        : EndIf

Ex_WorkCoDefinition       $OutputWorkOffsetListItem

Ex_DynamicOffset_Definition :
                          $OutputDynamicOffsetListItem

Ex_End_Declare_WorkCoDefinitions :
                        : If (OutputWorkOffsetList)
                        :   "G11"
                        :   "(*************************************************)"
                        :   BlankLine
                        : EndIf

############################# Sub Programs ##################################################################

Ex_Call_SubProgram      : $N CallMacro* MacroNumber* "(CALL CLString(613))"

Ex_Begin_Declare_SubProgram :
                        : BlankLine
                        : "(****************** SUB PROGRAMS ******************)"

Ex_SubProgram_Start     : MiscFormat10*(MacroNumber)

## Workaround for the case where the is no change in MotionCode from the initial positioning prior to the
## subprogram call, to the end of the operation after the sub program returns back to the main code.  GP
## needs to do this internally.
Ex_CallSubEnd           : ForceMisc(22)=(1)

Ex_SubProgram_End         $HighSpeedMachiningOff
                        : MacroEnd*
                        : Blankline

Ex_End_Declare_SubProgram :
                        : "(**************** END SUB PROGRAMS ****************)"

############################# Drilling Canned Cycles ########################################################

Ex_Hole_Cancel          : $N Cancel*

######### Drilling Cycle ######################################################

Ex_Drilling_Start       : $N WorkPlaneCode FeedUnit
                        : $N HoleCycleCode* ReturnPlaneCode* TC1LinearAxis2 WC1LinearAxis1 RPlane* FeedRateCode

Ex_Drilling_Body        : $N XAbsolute YAbsolute TC1LinearAxis2 WC1LinearAxis1 RotaryAxis1 RotaryAxis2 RPlane FeedRateCode

######### Spot Drilling Cycle #################################################

Ex_SpotDrilling_Start   : $N WorkPlaneCode FeedUnit
                        : $N HoleCycleCode* ReturnPlaneCode* TC1LinearAxis2 WC1LinearAxis1 RPlane* DwellTime* FeedRateCode

Ex_SpotDrilling_Body    : $N XAbsolute YAbsolute TC1LinearAxis2 WC1LinearAxis1 RotaryAxis1 RotaryAxis2 RPlane DwellTime FeedRateCode

######### Deep Hole Drilling Cycle with Chip Removal ##########################

